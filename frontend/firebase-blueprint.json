{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated VPHONE user profile synced from Google Sign-In or managed via RBAC.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ma": {
          "type": "string",
          "description": "VPHONE store user code (e.g., KH03)",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hoTen": {
          "type": "string",
          "description": "Display full name",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address",
          "minLength": 3,
          "maxLength": 200
        },
        "photoUrl": {
          "type": "string",
          "description": "Google profile avatar URL",
          "maxLength": 500
        },
        "vaiTro": {
          "type": "string",
          "description": "Role within VPHONE",
          "enum": ["KHACH_HANG", "NHAN_VIEN_BAN_HANG", "THU_KHO", "QUAN_TRI"]
        },
        "trangThai": {
          "type": "string",
          "description": "Account status (active or locked)",
          "enum": ["HOAT_DONG", "BI_KHOA"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": ["uid", "ma", "hoTen", "email", "vaiTro", "trangThai", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Elevated administrator access record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles with PII isolated to document owner and admins."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Administrator registry for RBAC lookup."
    }
  }
}
